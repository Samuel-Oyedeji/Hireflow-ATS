# HireFlow server-side environment.
# These are SERVER-ONLY — do NOT add a VITE_ prefix, or they'd be bundled into the
# browser. They are read only inside TanStack Start server functions.
# Copy to .env and fill in.

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (https://openrouter.ai/keys). Pick any model slug from
# https://openrouter.ai/models — e.g. anthropic/claude-sonnet-4.6, openai/gpt-4o, etc.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=

# Optional attribution shown on your OpenRouter dashboard.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=HireFlow
